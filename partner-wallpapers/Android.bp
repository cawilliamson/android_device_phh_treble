package = "com.restlessos.partner.wallpapers"

android_app {
    name: "RestlessWallpapers",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    export_package_resources: true,
    static_libs: ["com.google.android.material_material"],
    optimize: {
        enabled: true,
        shrink_resources: true,
    },
}
