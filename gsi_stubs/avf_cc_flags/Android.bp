// vendored from packages/modules/Virtualization/libs/libavf_cc_flags. the
// virtualization sources are excluded from the gsi manifest sync but the
// init first stage defaults link against this library for its avf build
// flag cflags, so the (header-only) library is reproduced here.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libavf_cc_flags",
    defaults: ["avf_build_flags_cc"],
    apex_available: [
        "//apex_available:platform",
        "com.android.virt",
    ],
    export_include_dirs: ["include"],
    local_include_dirs: ["include"],
    ramdisk_available: true,
    recovery_available: true,
}
